{
  "name": "JewishPrayer",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Day the prayer belongs to"
    },
    "prayer_key": {
      "type": "string",
      "enum": [
        "shacharit",
        "mincha",
        "maariv",
        "musaf"
      ],
      "description": "Daily prayer service"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "date",
    "prayer_key"
  ]
}