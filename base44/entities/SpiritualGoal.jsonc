{
  "name": "SpiritualGoal",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "prayer",
        "reading",
        "fasting",
        "habit",
        "custom"
      ],
      "default": "custom"
    },
    "target": {
      "type": "number",
      "default": 1
    },
    "unit": {
      "type": "string"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "custom"
      ],
      "default": "daily"
    },
    "reminder_time": {
      "type": "string",
      "description": "HH:mm"
    },
    "reminder_enabled": {
      "type": "boolean",
      "default": false
    },
    "completed_dates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dates (YYYY-MM-DD) the goal was checked in"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "paused"
      ],
      "default": "active"
    }
  },
  "required": [
    "user_id",
    "title"
  ]
}