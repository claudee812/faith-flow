{
  "name": "ChristianCalendarEvent",
  "type": "object",
  "properties": {
    "religion_key": {
      "type": "string",
      "default": "christianity"
    },
    "denomination_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Empty = applies to all denominations"
    },
    "name": {
      "type": "string"
    },
    "name_translations": {
      "type": "object",
      "properties": {
        "de": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "ar": {
          "type": "string"
        },
        "he": {
          "type": "string"
        }
      }
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fixed-date feast or memorial (YYYY-MM-DD)"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string",
      "enum": [
        "feast",
        "memorial",
        "fast",
        "season",
        "weekly"
      ],
      "default": "feast"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "religion_key",
    "name",
    "date"
  ]
}