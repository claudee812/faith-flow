{
  "name": "JournalEntry",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "prayer",
        "gratitude",
        "reflection",
        "goal",
        "thought",
        "other"
      ],
      "default": "other"
    },
    "mood": {
      "type": "string",
      "enum": [
        "peaceful",
        "grateful",
        "reflective",
        "hopeful",
        "neutral",
        "struggling"
      ],
      "default": "neutral"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "user_id",
    "content"
  ]
}