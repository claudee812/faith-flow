{
  "name": "HomeWidget",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id"
    },
    "religion_key": {
      "type": "string",
      "description": "Religion context for this widget config"
    },
    "widget_key": {
      "type": "string",
      "description": "Widget registry key"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id",
    "religion_key",
    "widget_key"
  ]
}