{
  "name": "Location",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Human-readable label"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "timezone": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "auto",
        "manual"
      ],
      "default": "manual"
    }
  },
  "required": [
    "user_id",
    "name"
  ]
}