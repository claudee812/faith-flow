{
  "name": "ChurchService",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id"
    },
    "day_of_week": {
      "type": "string",
      "enum": [
        "sun",
        "sat",
        "wed",
        "fri",
        "other"
      ],
      "default": "sun"
    },
    "service_time": {
      "type": "string",
      "description": "HH:mm"
    },
    "community_name": {
      "type": "string",
      "description": "Local congregation"
    },
    "reminder_enabled": {
      "type": "boolean",
      "default": true
    },
    "checklist_arrived": {
      "type": "boolean",
      "default": false
    },
    "checklist_worship": {
      "type": "boolean",
      "default": false
    },
    "checklist_fellowship": {
      "type": "boolean",
      "default": false
    },
    "checklist_note": {
      "type": "string"
    },
    "last_attended_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "user_id"
  ]
}