{
  "name": "ReadingProgress",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "text_id": {
      "type": "string",
      "description": "Identifier of the religious text/book"
    },
    "text_title": {
      "type": "string"
    },
    "chapter": {
      "type": "string"
    },
    "verse": {
      "type": "string"
    },
    "progress_percent": {
      "type": "number",
      "default": 0
    },
    "last_read_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "user_id",
    "text_id"
  ]
}